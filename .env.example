# Supabase（ダッシュボードの Project Settings → API）。anon / publishable key は公開前提の値。
# service role key はこのアプリでは使わない。ここにも Vercel にも置かない。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# フッターの表示（公選法 142条の3 の運営者・連絡先）。サイト名は DB（管理画面の「公開する」で切り替わる）
OPERATOR_NAME=
# メールアドレスか https の URL
CONTACT=
# このアプリのソースを公開している repo（AGPL-3.0 §13）
SOURCE_URL=
# 任意。運営者のプライバシーポリシー（公式サイトなど）の https の URL。入れるとプライバシーページにリンクが出る
OPERATOR_PRIVACY_URL=
# 任意。ボランティア向けの問い合わせ先（文字で書く）。使い方ガイドで、参加中の人にだけ出す。
# 未設定なら「参加コードを受け取った事務局の担当者に連絡してください。」と出す
VOLUNTEER_CONTACT=

# 管理画面の Google ログインの戻り先（このサイトの origin）。例: http://localhost:3000
APP_ORIGIN=
# ローカルだけ "local" にすると、管理画面にパスワードの入り口が出る。本番（Vercel）には設定しない
ADMIN_PASSWORD_LOGIN=

# 確認用の環境（Vercel の Preview）だけのベーシック認証。Vercel の Preview の環境変数にだけ入れる。
# 本番（Production）とローカルには設定しない。Preview で空だと確認用の環境は 503 で閉じる。値は 1Password に保存する
PREVIEW_BASIC_AUTH_USER=
PREVIEW_BASIC_AUTH_PASSWORD=
