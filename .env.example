# Supabase（ダッシュボードの Project Settings → API）。anon / publishable key は公開前提の値。
# service role key はこのアプリでは使わない。ここにも Vercel にも置かない。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# フッターの表示（公選法 142条の3 の運営者・連絡先）
# 本番の SITE_NAME は「福岡市ポスター掲示板マップ」（立候補の届出の受理前の名前）
SITE_NAME=
OPERATOR_NAME=
# メールアドレスか https の URL
CONTACT=
# このアプリのソースを公開している repo（AGPL-3.0 §13）
SOURCE_URL=
# 任意。運営者のプライバシーポリシー（公式サイトなど）の https の URL。入れるとプライバシーページにリンクが出る
OPERATOR_PRIVACY_URL=
# 任意。ボランティア向けの問い合わせ先（文字で書く）。使い方ガイドで、参加中の人にだけ出す。
# 未設定なら「参加コードを受け取った事務局の担当者に連絡してください。」と出す
VOLUNTEER_CONTACT=
